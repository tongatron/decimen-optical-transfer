# Both values already have working defaults in vite.config.ts, so this file is
# only needed to report to a different Umami instance. The tracker is injected
# by `npm run build`, never by the dev server.

# The Website ID from the Umami website settings. Leave it empty to build the
# site with no analytics at all.
UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000

# The tracker of the Umami instance that owns that Website ID.
UMAMI_SCRIPT_URL=https://analytics.example.org/script.js
