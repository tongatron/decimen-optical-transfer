{
  "name": "decimen-optical-transfer",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Proof of concept: file transfer between two devices using fountain-coded animated QR codes — screen to camera, no network.",
  "homepage": "https://optical-transfer.tongatron.org/",
  "repository": {
    "type": "git",
    "url": "https://github.com/tongatron/decimen-optical-transfer.git"
  },
  "bin": {
    "decimen": "dist-cli/decimen.cjs"
  },
  "files": [
    "dist",
    "dist-cli",
    "macos",
    "windows",
    "linux",
    "docs/cli-finder-roadmap.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:cli": "node scripts/build-cli.mjs",
    "typecheck": "tsc && tsc -p tsconfig.tests.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browsers": "playwright test",
    "send": "tsx cli/decimen.ts",
    "simulate": "tsx simulator/cli.ts",
    "check": "npm run test && npm run build && npm run build:cli",
    "prepare": "npm run build && npm run build:cli"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "esbuild": "^0.25.12",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.6",
    "zxing-wasm": "^2.0.0"
  }
}
